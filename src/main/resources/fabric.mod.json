{
	"schemaVersion": 1,
	"id": "jade",
	"version": "${version}",
	"name": "Jade",
	"description": "Minecraft mod shows what you are looking at. (Hwyla fork)",
	"authors": [
		"Snownee"
	],
	"contributors": [
		"TehNut",
		"ProfMobius",
		"kalkafox"
	],
	"icon": "assets/jade/icon.png",
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/jade",
		"sources": "https://github.com/Snownee/Jade",
		"issues": "https://github.com/Snownee/Jade/issues"
	},
	"license": "CC BY-NC-SA 4.0",
	"environment": "*",
	"entrypoints": {
		"init": [
			"snownee.jade.util.CommonProxy"
		],
		"client-init": [
			"snownee.jade.util.ClientProxy"
		],
		"jade": [
			"snownee.jade.addon.core.CorePlugin",
			"snownee.jade.addon.debug.DebugPlugin"
		]
	},
	"mixins": [
		"jade.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "1.12.2",
		"osl-entrypoints": ">=0.4.0",
		"osl-lifecycle-events": ">=0.5.0",
		"osl-keybinds": ">=0.1.0",
		"osl-networking": ">=0.8.0",
		"osl-resource-loader": ">=0.5.0"
	}
